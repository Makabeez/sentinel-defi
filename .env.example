SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
PORT=8080
WS_PORT=8081

# Telegram alerts (create the bot with @BotFather; never commit the real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: ms between reminders for an ongoing problem (default 6h), and how many reminders before going quiet (default 2)
ALERT_REMIND_MS=21600000
ALERT_MAX_REMINDERS=2
